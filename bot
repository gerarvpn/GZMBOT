async def show_status(target, context, uid, is_edit=False):
    state = load_state()
    admin = is_admin(uid)
    in_group = await esta_en_grupo(context.bot, uid) if state.get('group_linked') else None

    text = (
        f"📊 *Tu estado*\n\n"
        f"🆔 ID: `{uid}`\n"
        f"👑 Admin: {'✅ sí' if admin else '❌ no'}\n"
    )
    if state.get('group_linked'):
        gname = state.get('group_name','?')
        if in_group is True:
            text += f"👥 Grupo *{gname}*: ✅ miembro\n"
        elif in_group is False:
            text += f"👥 Grupo *{gname}*: ❌ no eres miembro\n"
        else:
            text += f"👥 Grupo *{gname}*: ⚠️ no verificado\n"
    else:
        text += "👥 Grupo: ⚠️ no configurado\n"

    kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Menú", callback_data="m:menu")]])
    if is_edit:
        try: await target.edit_text(text, parse_mode="Markdown", reply_markup=kb)
        except: await target.reply_text(text, parse_mode="Markdown", reply_markup=kb)
    else:
        await target.reply_text(text, parse_mode="Markdown", reply_markup=kb)

# ── Callback ─────────────────────────────────────────────────
async def on_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    try:
        await q.answer()
    except Exception:
        pass
    data = q.data
    uid = update.effective_user.id

    if data == "m:menu":
        await show_menu(q.message, is_edit=True)
    elif data == "m:gen":
        await do_generate(q.message, context, uid, is_edit=True)
    elif data == "m:help":
        await show_help(q.message, is_edit=True)
    elif data == "m:status":
        await show_status(q.message, context, uid, is_edit=True)
    elif data == "m:id":
        try:
            await q.message.edit_text(
                f"🆔 Tu ID: `{uid}`", parse_mode="Markdown",
                reply_markup=InlineKeyboardMarkup([[
                    InlineKeyboardButton("🔙 Volver", callback_data="m:menu")
                ]]))
        except Exception:
            pass

# ── Comandos ─────────────────────────────────────────────────
async def cmd_start(u: Update, c: ContextTypes.DEFAULT_TYPE):
    # En grupo → redirigir a privado
    if u.effective_chat.type in ('group','supergroup'):
        me = await c.bot.get_me()
        await u.message.reply_text(
            f"👋 Para generar instaladores escríbeme en privado: @{me.username}")
        return

    uid = u.effective_user.id
    state = load_state()

    # Admin → menú
    if is_admin(uid):
        await show_menu(u.message)
        return

    # No admin → verificar grupo ANTES de mostrar nada
    if not state.get('group_linked'):
        await u.message.reply_text(
            "⚠️ *El bot aún no está vinculado a un grupo.*\n\n"
            "Pide al administrador que añada el bot al grupo oficial.",
            parse_mode="Markdown")
        return

    in_group = await esta_en_grupo(c.bot, uid)
    if in_group is not True:
        invite = state.get('group_invite_url','')
        gname = state.get('group_name','el grupo')
        await u.message.reply_text(
            f"🔒 *Acceso restringido*\n\n"
            f"Para generar instaladores debes ser miembro del grupo *{gname}*.\n\n"
            f"🆔 Tu ID: `{uid}`\n\n"
            f"Únete al grupo y pulsa *Ya me uní*.",
            parse_mode="Markdown",
            reply_markup=join_kb(invite, gname))
        return

    await show_menu(u.message)

async def cmd_help(u: Update, c: ContextTypes.DEFAULT_TYPE):
