async def cmd_nuevo(u: Update, c: ContextTypes.DEFAULT_TYPE):
    await do_generate(u.message, c, u.effective_user.id)

async def cmd_setgithub(u: Update, c: ContextTypes.DEFAULT_TYPE):
    if not is_admin(u.effective_user.id):
        await u.message.reply_text("⛔ Solo administradores."); return
    if not c.args:
        await u.message.reply_text("Uso: `/setgithub <url>`", parse_mode="Markdown"); return
    url = c.args[0]
    if 'github.com' in url and '/blob/' in url:
        url = url.replace('github.com','raw.githubusercontent.com').replace('/blob/','/')
    try:
        async with httpx.AsyncClient(follow_redirects=True, timeout=15) as cli:
            r = await cli.get(url)
            if r.status_code != 200:
                await u.message.reply_text(f"❌ HTTP {r.status_code}"); return
    except Exception:
        await u.message.reply_text("❌ URL inválida."); return
    s = load_state(); s['github_url'] = url; save_state(s)
    await u.message.reply_text("✅ Fuente actualizada.")

async def cmd_addadmin(u: Update, c: ContextTypes.DEFAULT_TYPE):
    if not is_admin(u.effective_user.id):
        await u.message.reply_text("⛔ Solo administradores."); return
    if not c.args:
        await u.message.reply_text("Uso: `/addadmin <id>`", parse_mode="Markdown"); return
    try:
        uid = int(c.args[0])
    except ValueError:
        await u.message.reply_text("❌ ID inválido."); return
    s = load_state()
    if uid in s['admins']:
        await u.message.reply_text("ℹ️ Ya es admin."); return
    s['admins'].append(uid); save_state(s)
    await u.message.reply_text(f"✅ Admin añadido: `{uid}`", parse_mode="Markdown")

async def cmd_rmadmin(u: Update, c: ContextTypes.DEFAULT_TYPE):
    if not is_admin(u.effective_user.id):
        await u.message.reply_text("⛔ Solo administradores."); return
    if not c.args:
        await u.message.reply_text("Uso: `/rmadmin <id>`", parse_mode="Markdown"); return
    try:
        uid = int(c.args[0])
    except ValueError:
        await u.message.reply_text("❌ ID inválido."); return
    s = load_state()
    if uid not in s['admins']:
        await u.message.reply_text("ℹ️ No es admin."); return
    if len(s['admins']) == 1:
        await u.message.reply_text("⚠️ No puedes quitar al último admin."); return
    s['admins'].remove(uid); save_state(s)
    await u.message.reply_text(f"🗑️ Admin eliminado: `{uid}`", parse_mode="Markdown")

async def cmd_admins(u: Update, c: ContextTypes.DEFAULT_TYPE):
