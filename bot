async def cmd_config(u: Update, c: ContextTypes.DEFAULT_TYPE):
    if not is_admin(u.effective_user.id):
        await u.message.reply_text("⛔ Solo administradores."); return
    s = load_state()
    vinculado = "✅ Sí" if s.get('group_linked') else "❌ No"
    txt = (
        "⚙️ *Configuración*\n\n"
        f"🌐 Dominio: `{FULL_DOMAIN}`\n"
        f"🔌 Puerto: `{PORT}`\n"
        f"⏱️ TTL: `{TTL//60} min`\n"
        f"👥 Grupo: *{s.get('group_name','—')}*\n"
        f"🔗 Vinculado: {vinculado}\n"
        f"👑 Admins: `{len(s.get('admins',[]))}`\n"
        f"📁 Instaladores: `{len(list(INSTALLERS.glob('*.sh'))) - 1}`"
    )
    await u.message.reply_text(txt, parse_mode="Markdown")

# ── Bloqueo global ───────────────────────────────────────────
async def on_message(u: Update, c: ContextTypes.DEFAULT_TYPE):
    uid = u.effective_user.id
    if is_admin(uid):
        return
    state = load_state()
    if not state.get('group_linked'):
        return
    if await esta_en_grupo(c.bot, uid) is True:
        return
    invite = state.get('group_invite_url','')
    gname = state.get('group_name','el grupo')
    await u.message.reply_text(
        f"🔒 Debes ser miembro del grupo *{gname}* para usar este bot.",
        parse_mode="Markdown",
        reply_markup=join_kb(invite, gname))

def main():
    log.info(f"Bot iniciado | {FULL_DOMAIN}:{PORT}")
    # ── Recuperar grupo si el bot ya estaba en uno ──
    state = load_state()
    recover_group_sync(state)

    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("nuevo", cmd_nuevo))
    app.add_handler(CommandHandler("help", cmd_help))
    app.add_handler(CommandHandler("miid", cmd_miid))
    app.add_handler(CommandHandler("setgithub", cmd_setgithub))
    app.add_handler(CommandHandler("addadmin", cmd_addadmin))
    app.add_handler(CommandHandler("rmadmin", cmd_rmadmin))
    app.add_handler(CommandHandler("admins", cmd_admins))
    app.add_handler(CommandHandler("config", cmd_config))
    app.add_handler(ChatMemberHandler(on_my_chat_member, ChatMemberHandler.MY_CHAT_MEMBER))
    app.add_handler(CallbackQueryHandler(on_callback))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, on_message))
    app.run_polling(drop_pending_updates=True, allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
