import os, json, logging, uuid, time, datetime
from pathlib import Path
import httpx
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application, CommandHandler, ContextTypes,
    ChatMemberHandler, MessageHandler, CallbackQueryHandler, filters
)
try:
    from telegram import CopyTextButton
    HAS_COPY = True
except ImportError:
    HAS_COPY = False

CONFIG = {}
with open('/opt/bot-installer/config.env') as f:
    for line in f:
        if '=' in line:
            k, v = line.strip().split('=', 1)
            CONFIG[k] = v

TOKEN       = CONFIG['BOT_TOKEN']
FULL_DOMAIN = CONFIG['FULL_DOMAIN']
PORT        = CONFIG['PORT']
INSTALLERS  = Path(CONFIG['INSTALLERS_DIR'])
INSTALLERS.mkdir(parents=True, exist_ok=True)
BASE_URL    = f"http://{FULL_DOMAIN}:{PORT}"
STATE_FILE  = '/opt/bot-installer/state.json'
TTL         = int(CONFIG.get('TOKEN_TTL', '3600'))

logging.basicConfig(format='%(asctime)s %(levelname)s %(message)s', level=logging.INFO)
log = logging.getLogger(__name__)

def load_state():
    if not os.path.exists(STATE_FILE):
        return {'github_url':'','admins':[],'group_id':'','group_name':'','group_invite_url':'','group_linked':False}
    with open(STATE_FILE) as f:
        return json.load(f)

def save_state(s):
    with open(STATE_FILE, 'w') as f:
        json.dump(s, f, indent=2)

def is_admin(uid):
    return uid in load_state().get('admins', [])

# ── RECUPERACIÓN DE GRUPO AL ARRANCAR ────────────────────────
def recover_group_sync(state):
    """Si no hay grupo vinculado pero el bot YA está en un grupo,
       lo recupera desde getUpdates pendientes de Telegram."""
    if state.get('group_linked'):
        return
    log.info("Recuperando grupo desde updates pendientes...")
    try:
        with httpx.Client(timeout=15) as cli:
            # Quitar webhook para que getUpdates funcione
            cli.get(f"https://api.telegram.org/bot{TOKEN}/deleteWebhook")
            r = cli.get(f"https://api.telegram.org/bot{TOKEN}/getUpdates",
                        params={"limit": 100, "timeout": 0})
            data = r.json()
            if not data.get('ok'):
                log.warning("getUpdates falló")
                return

            groups = {}
            for upd in data.get('result', []):
                chat = None
                for key in ('message', 'my_chat_member', 'channel_post', 'edited_message'):
                    if key in upd:
                        chat = upd[key].get('chat')
                        break
                if chat and chat.get('type') in ('group', 'supergroup'):
                    groups[chat['id']] = chat.get('title', 'Grupo')

            if not groups:
                log.info("No hay grupos en updates pendientes")
                return

            # Preferir el que coincida con group_name configurado
            target = state.get('group_name', '').lower()
            gid = gname = None
            for g_id, g_name in groups.items():
                if target and target in g_name.lower():
                    gid, gname = g_id, g_name
                    break
            if gid is None:
                gid, gname = list(groups.items())[0]

            # Verificar que el bot sigue en el grupo
            try:
                r2 = cli.get(f"https://api.telegram.org/bot{TOKEN}/getChat",
                             params={"chat_id": gid})
                if not r2.json().get('ok'):
                    log.warning(f"Bot no está en el grupo {gid}")
                    return
                chat_info = r2.json()['result']
                gname = chat_info.get('title', gname)
            except Exception as e:
                log.warning(f"getChat falló: {e}")
                return

            state['group_id'] = str(gid)
            state['group_name'] = gname
            state['group_linked'] = True

            # Intentar crear invite link
            try:
                r3 = cli.get(f"https://api.telegram.org/bot{TOKEN}/createChatInviteLink",
                             params={"chat_id": gid, "name": "Bot Share"})
                if r3.json().get('ok'):
                    state['group_invite_url'] = r3.json()['result']['invite_link']
            except Exception:
                pass

            save_state(state)
            log.info(f"✓ Grupo recuperado: {gid} ({gname})")
    except Exception as e:
        log.error(f"recover_group error: {e}")

def limpiar(code):
    if code.startswith('\ufeff'):
        code = code[1:]
    code = code.replace('\r\n','\n').replace('\r','\n')
    if not code.startswith('#!'):
        code = '#!/bin/bash\n' + code
    if not code.endswith('\n'):
        code += '\n'
    return code

async def esta_en_grupo(bot, uid):
    state = load_state()
    gid = state.get('group_id','')
    if not gid:
        return None
    try:
        member = await bot.get_chat_member(chat_id=gid, user_id=uid)
        return member.status in ('creator','administrator','member')
    except Exception as e:
        log.warning(f"get_chat_member: {e}")
        return False

def copy_btn(label, text):
    if not HAS_COPY:
        return None
    try:
        return InlineKeyboardButton(label, copy_text=CopyTextButton(text=text))
    except Exception:
        return None

# ── Auto-vinculación ─────────────────────────────────────────
async def on_my_chat_member(update: Update, context: ContextTypes.DEFAULT_TYPE):
    cm = update.my_chat_member
    if not cm:
        return
    chat = cm.chat
    if chat.type not in ('group','supergroup'):
        return

    old = cm.old_chat_member.status if cm.old_chat_member else 'left'
    new = cm.new_chat_member.status if cm.new_chat_member else 'left'

    state = load_state()
    linked_gid = state.get('group_id','')

    if old in ('member','administrator') and new in ('left','kicked'):
        if str(chat.id) == linked_gid:
            state['group_id'] = ''
            state['group_name'] = ''
            state['group_invite_url'] = ''
            state['group_linked'] = False
            save_state(state)
            log.info(f"Grupo desvinculado: {chat.id}")
        return

    if not (old in ('left','kicked') and new in ('member','administrator')):
        return

    adder = cm.from_user

    if state.get('group_linked') and str(chat.id) != linked_gid:
        gname = state.get('group_name','el grupo oficial')
        invite = state.get('group_invite_url','')
        text = f"⚠️ Este bot solo funciona con *{gname}*."
        if invite:
            text += f"\n\n👉 Únete: {invite}"
        try:
            await context.bot.send_message(chat_id=chat.id, text=text,
                parse_mode="Markdown", disable_web_page_preview=True)
        except Exception:
            pass
        try:
            await context.bot.leave_chat(chat.id)
        except Exception:
            pass
        return

    if not adder or not is_admin(adder.id):
        try:
            await context.bot.send_message(
                chat_id=chat.id,
                text="⚠️ Solo el administrador del bot puede vincular este grupo.")
        except Exception:
            pass
        try:
            await context.bot.leave_chat(chat.id)
        except Exception:
            pass
        return

    invite = ""
    try:
        if chat.username:
            invite = f"https://t.me/{chat.username}"
        else:
            link = await context.bot.create_chat_invite_link(
                chat_id=chat.id, name="Bot Share")
            invite = link.invite_link
    except Exception as e:
        log.warning(f"invite link: {e}")

    state['group_id'] = str(chat.id)
    state['group_name'] = chat.title or 'Grupo'
    state['group_invite_url'] = invite
    state['group_linked'] = True
    save_state(state)
    log.info(f"Grupo vinculado: {chat.id} ({chat.title})")

    try:
        await context.bot.send_message(
            chat_id=chat.id,
            text=(f"✅ *Grupo vinculado correctamente*\n\n"
                  f"Nombre: *{chat.title}*\n\n"
                  f"Los miembros ya pueden generar instaladores con /start al bot en privado."),
            parse_mode="Markdown")
    except Exception:
        pass

# ── Teclados ──────────────────────────────────────────────────
def menu_kb():
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("🚀 Generar instalador", callback_data="m:gen")],
        [InlineKeyboardButton("ℹ️ Ayuda", callback_data="m:help"),
         InlineKeyboardButton("📊 Mi estado", callback_data="m:status")],
        [InlineKeyboardButton("🆔 Mi ID", callback_data="m:id")]
    ])

def join_kb(invite, gname):
    rows = []
    if invite:
        rows.append([InlineKeyboardButton(f"🔗 Unirse a {gname}", url=invite)])
    rows.append([InlineKeyboardButton("✅ Ya me uní", callback_data="m:gen")])
    rows.append([InlineKeyboardButton("🆔 Mi ID", callback_data="m:id")])
    return InlineKeyboardMarkup(rows)

# ── Generar ──────────────────────────────────────────────────
async def do_generate(target, context, uid, is_edit=False):
    state = load_state()

    # Verificación doble (defensa en profundidad)
    if not is_admin(uid):
        if not state.get('group_linked'):
            text = ("⚠️ El bot aún no está vinculado a un grupo.\n"
                    "Contacta al administrador.")
            if is_edit:
                try: await target.edit_text(text)
                except: await target.reply_text(text)
            else:
                await target.reply_text(text)
            return

        in_group = await esta_en_grupo(context.bot, uid)
        if in_group is not True:
            invite = state.get('group_invite_url','')
            gname = state.get('group_name','el grupo')
            text = (
                f"🔒 *Acceso restringido*\n\n"
                f"Para generar instaladores debes ser miembro del grupo *{gname}*.\n\n"
                f"🆔 Tu ID: `{uid}`"
            )
            kb = join_kb(invite, gname)
            if is_edit:
                try: await target.edit_text(text, parse_mode="Markdown", reply_markup=kb)
                except: await target.reply_text(text, parse_mode="Markdown", reply_markup=kb)
            else:
                await target.reply_text(text, parse_mode="Markdown", reply_markup=kb)
            return

    url = state.get('github_url','')
    if not url:
        txt = "⚠️ No hay fuente configurada."
        await (target.edit_text(txt) if is_edit else target.reply_text(txt))
        return

    if is_edit:
        try: msg = await target.edit_text("⚙️ Generando instalador...")
        except: msg = await target.reply_text("⚙️ Generando instalador...")
    else:
        msg = await target.reply_text("⚙️ Generando instalador...")

    try:
        async with httpx.AsyncClient(follow_redirects=True, timeout=60) as cli:
            r = await cli.get(url)
            if r.status_code != 200:
                await msg.edit_text("❌ Error interno.")
                return
            code = r.text
        if not code.strip():
            await msg.edit_text("❌ Recurso vacío.")
            return

        code = limpiar(code)
        t = str(uuid.uuid4())
        now = int(time.time())
        expires = now + TTL

        (INSTALLERS / f"{t}.sh").write_text(code)
        (INSTALLERS / f"{t}.json").write_text(json.dumps({
            'created_at': now, 'expires_at': expires, 'creator_id': uid
        }))

        exp_str = datetime.datetime.fromtimestamp(expires).strftime("%d/%m/%Y %H:%M")
        cmd = f"curl -sL {BASE_URL}/install.sh | bash"

        text = (
            f"✅ *Instalador generado*\n\n"
            f"⏱️ Válido 1 hora · expira {exp_str}\n\n"
            f"📋 *Comando de instalación:*\n"
            f"`{cmd}`\n\n"
            f"🔑 *Token de acceso:*\n"
            f"`{t}`"
        )

        rows = []
        b1 = copy_btn("📋 Copiar comando", cmd)
        b2 = copy_btn("🔑 Copiar token", t)
        if b1: rows.append([b1])
        if b2: rows.append([b2])
        rows.append([InlineKeyboardButton("🔄 Generar otro", callback_data="m:gen")])
        rows.append([InlineKeyboardButton("🔙 Menú", callback_data="m:menu")])
        kb = InlineKeyboardMarkup(rows)

        try:
            await msg.edit_text(text, parse_mode="Markdown",
                disable_web_page_preview=True, reply_markup=kb)
        except Exception:
            await msg.edit_text(text, disable_web_page_preview=True)

    except httpx.TimeoutException:
        await msg.edit_text("❌ Tiempo de espera agotado.")
    except httpx.ConnectError:
        await msg.edit_text("❌ Sin conexión.")
    except Exception:
        log.exception("Error generar")
        await msg.edit_text("❌ Error interno.")

